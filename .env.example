# Create a Sanity project at https://sanity.io/manage (or via
# `npx sanity login` then `npx sanity init` from this folder), then copy
# this file to `.env` and fill in the values it prints out.
VITE_SANITY_PROJECT_ID=3hjqpfgb
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Write token for scripts/seed-sanity.mjs only (npm run seed). Create at
# sanity.io/manage -> project -> API -> Tokens ("Editor" permission).
# No VITE_ prefix — this must never be bundled into client-side code.
SANITY_WRITE_TOKEN=
